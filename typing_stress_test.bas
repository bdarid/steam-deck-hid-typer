' HID TYPING TEST - DO NOT RUN
VAR MESSAGE$,VALUE#,I
MESSAGE$="Upper lower MixedCase 123"
VALUE#=12345
PRINT MESSAGE$
PRINT VALUE#
FOR I=1 TO 3
  PRINT "ROUND",I
NEXT
IF VALUE#>0 THEN PRINT "OK"
PRINT "FIRST":PRINT "SECOND"
' SYMBOLS: ! @ # $ % ^ & * ( ) - _ = + [ ] { } \ | ; : ' " , . < > / ?
PRINT "LONG LINE WITH SUFFIXES: MESSAGE$ VALUE# COUNT"
FOR I=10 TO 12:PRINT "I=",I:NEXT
END
COMMON DEF TEST$(S$)
  VAR T$=S$
  RETURN T$
END
' FINAL SENTINEL: ALPHA alpha MixedCase 9876543210
